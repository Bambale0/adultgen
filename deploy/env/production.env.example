# AdultGen production environment template
# Copy to .env.production and fill every secret before deploy.

ADULTGEN_IMAGE_TAG=local
HTTP_PORT=80
MINIO_CONSOLE_PORT=9001

POSTGRES_DB=adultgen
POSTGRES_USER=adultgen
POSTGRES_PASSWORD=change-me-postgres-password-32-chars-min

MINIO_ROOT_USER=adultgen-minio
MINIO_ROOT_PASSWORD=change-me-minio-root-password-32-chars-min
S3_REGION_NAME=us-east-1
S3_TEMP_BUCKET=media-temporary
S3_PUBLISHED_BUCKET=media-published
S3_REFERENCES_BUCKET=media-references
S3_WEBHOOK_BUCKET=webhook-archive

APP_ENV=production
APP_NAME=adultgen
BILLING_BASE_URL=https://example.com
JWT_SECRET=change-me-64-plus-random-chars
JWT_ACCESS_TOKEN_TTL_SECONDS=86400
MINI_APP_AUTH_MAX_AGE_SECONDS=86400
ADMIN_API_TOKEN=change-me-admin-token-64-plus-random-chars
ADULT_POLICY_VERSION=adult-policy-v1
MEDIA_TEMP_TTL_SECONDS=86400

TELEGRAM_DEFAULT_WEBHOOK_SECRET=change-me-telegram-webhook-secret
TELEGRAM_DEFAULT_BOT_TOKEN=0000000000:replace-me

KIE_API_BASE_URL=https://api.kie.ai
KIE_API_KEY=replace-me
KIE_CALLBACK_URL=https://example.com/api/webhooks/kie
KIE_WEBHOOK_SECRET=change-me-kie-webhook-secret

SHARPAY_API_KEY=replace-me-or-empty
CROCOPAY_API_KEY=replace-me-or-empty
CROCOPAY_SECRET=replace-me-or-empty
CROCOPAY_API_BASE_URL=https://crocopay.tech
CROCOPAY_CLIENT_ID=replace-me-or-empty
CROCOPAY_CLIENT_SECRET=replace-me-or-empty
