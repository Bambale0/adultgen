# AdultGen production environment template.
# Copy to .env.production and replace every CHANGE_ME value before running deploy scripts.

APP_ENV=production
APP_NAME=adultgen
HTTP_PORT=80
MINIO_CONSOLE_PORT=9001

POSTGRES_DB=adultgen
POSTGRES_USER=adultgen
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD_32_CHARS_MIN

MINIO_ROOT_USER=adultgen-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD_32_CHARS_MIN
S3_REGION_NAME=us-east-1
S3_TEMP_BUCKET=media-temporary
S3_PUBLISHED_BUCKET=media-published
S3_REFERENCES_BUCKET=media-references
S3_WEBHOOK_BUCKET=webhook-archive
MEDIA_TEMP_TTL_SECONDS=86400

TELEGRAM_DEFAULT_WEBHOOK_SECRET=CHANGE_ME_TELEGRAM_WEBHOOK_SECRET
TELEGRAM_DEFAULT_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN

KIE_API_BASE_URL=https://api.kie.ai
KIE_API_KEY=CHANGE_ME_KIE_API_KEY
KIE_CALLBACK_URL=https://example.com/webhooks/kie
KIE_WEBHOOK_SECRET=CHANGE_ME_KIE_WEBHOOK_SECRET

BILLING_BASE_URL=https://example.com
SHARPAY_API_KEY=
CROCOPAY_API_KEY=
CROCOPAY_SECRET=
CROCOPAY_API_BASE_URL=https://crocopay.tech
CROCOPAY_CLIENT_ID=CHANGE_ME_CROCOPAY_CLIENT_ID
CROCOPAY_CLIENT_SECRET=CHANGE_ME_CROCOPAY_CLIENT_SECRET

JWT_SECRET=CHANGE_ME_JWT_SECRET_64_CHARS_MIN
JWT_ACCESS_TOKEN_TTL_SECONDS=86400
MINI_APP_AUTH_MAX_AGE_SECONDS=86400
ADMIN_API_TOKEN=CHANGE_ME_ADMIN_API_TOKEN_64_CHARS_MIN
ADULT_POLICY_VERSION=adult-policy-v1
