# Runtime
APP_ENV=local
APP_NAME=adultgen
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://adultgen:adultgen@localhost:5432/adultgen
REDIS_URL=redis://localhost:6379/0

# Object storage
# local = filesystem-backed dev storage, s3 = S3/MinIO-compatible storage
OBJECT_STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=adultgen
S3_SECRET_KEY=adultgen_secret
S3_REGION_NAME=us-east-1
S3_TEMP_BUCKET=media-temporary
S3_PUBLISHED_BUCKET=media-published
S3_REFERENCES_BUCKET=media-references
S3_WEBHOOK_BUCKET=webhook-archive
MEDIA_TEMP_TTL_SECONDS=86400

# Telegram channel registry can point to env/secret manager references.
# Never commit real bot tokens.
TELEGRAM_DEFAULT_WEBHOOK_SECRET=change-me
TELEGRAM_DEFAULT_BOT_TOKEN=123456:change-me

# Kie.ai
KIE_API_BASE_URL=https://api.kie.ai
KIE_API_KEY=change-me
KIE_CALLBACK_URL=https://api.example.com/webhooks/kie

# Billing
BILLING_BASE_URL=https://pay.example.com
SHARPAY_API_KEY=change-me
CROCOPAY_API_KEY=change-me
CROCOPAY_SECRET=change-me

# Security
JWT_SECRET=change-me
JWT_ACCESS_TOKEN_TTL_SECONDS=86400
MINI_APP_AUTH_MAX_AGE_SECONDS=86400
ADMIN_API_TOKEN=change-me-admin-token
ADULT_POLICY_VERSION=adult-policy-v1
